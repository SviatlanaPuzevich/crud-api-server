{
  "name": "crud-api-server",
  "version": "1.0.0",
  "description": "simple CRUD server on bare nodejs",
  "homepage": "https://github.com/SviatlanaPuzevich/crud-api-server#readme",
  "bugs": {
    "url": "https://github.com/SviatlanaPuzevich/crud-api-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SviatlanaPuzevich/crud-api-server.git"
  },
  "license": "ISC",
  "author": "Svetlana Rudaya",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "build": "webpack",
    "start:prod": "npm run build && node dist/server.js",
    "start:dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "start:cluster": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/cluster/cluster.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
